{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autopw.local/schemas/lane-result.schema.json",
  "title": "AutoPW execution facts",
  "$defs": {
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["started_at", "finished_at", "duration_ms"],
      "properties": {
        "started_at": { "type": "string", "format": "date-time" },
        "finished_at": { "type": "string", "format": "date-time" },
        "duration_ms": { "type": "number", "minimum": 0 }
      }
    },
    "blocked": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "detail"],
      "properties": {
        "code": { "enum": ["SERVICE_UNAVAILABLE", "EXECUTOR_UNAVAILABLE", "MISSING_CREDENTIAL", "DEPENDENCY_UNAVAILABLE", "POLICY_RESTRICTED", "DIAGNOSTIC_UNAVAILABLE"] },
        "detail": { "type": "string", "minLength": 1 },
        "dependency": { "type": "string", "minLength": 1 }
      }
    },
    "not_run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "detail"],
      "properties": {
        "code": { "enum": ["OUT_OF_SCOPE", "UNSAFE_TO_EXECUTE", "MISSING_CREDENTIAL", "DEPENDENCY_UNAVAILABLE", "UNSUPPORTED_ENVIRONMENT", "USER_EXCLUDED"] },
        "detail": { "type": "string", "minLength": 1 },
        "dependency": { "type": "string", "minLength": 1 }
      }
    },
    "execution_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runner", "runner_version", "browser", "browser_build", "viewport", "locale", "timezone", "spec_path", "test_title", "storage_state_contract", "steps", "assertions", "locator_contract"],
      "properties": {
        "runner": { "type": "string", "minLength": 1 },
        "runner_version": { "type": "string", "minLength": 1 },
        "browser": { "type": "string", "minLength": 1 },
        "browser_build": { "type": "string", "minLength": 1 },
        "viewport": { "type": "object", "additionalProperties": false, "required": ["width", "height"], "properties": { "width": { "type": "integer", "minimum": 1 }, "height": { "type": "integer", "minimum": 1 } } },
        "locale": { "type": "string", "minLength": 1 },
        "timezone": { "type": "string", "minLength": 1 },
        "spec_path": { "type": "string", "minLength": 1 },
        "test_title": { "type": "string", "minLength": 1 },
        "storage_state_contract": { "type": "string", "minLength": 1 },
        "steps": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "assertions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "locator_contract": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "failure_signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "failure_type", "route", "assertion", "locator", "http_method", "http_status", "top_stack_frame"],
      "properties": {
        "case_id": { "type": "string", "minLength": 1 },
        "failure_type": { "enum": ["ASSERTION", "LOCATOR", "REQUEST_FAILED", "PAGE_ERROR", "NAVIGATION", "TIMEOUT", "INFRASTRUCTURE"] },
        "route": { "type": ["string", "null"] },
        "assertion": { "type": ["string", "null"] },
        "locator": { "type": ["string", "null"] },
        "http_method": { "type": ["string", "null"] },
        "http_status": { "type": ["integer", "null"] },
        "top_stack_frame": { "type": ["string", "null"] }
      }
    },
    "case_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "attempt", "status", "timing"],
      "properties": {
        "case_id": { "type": "string", "minLength": 1 },
        "attempt": { "type": "integer", "minimum": 1, "maximum": 2 },
        "status": { "enum": ["PASS", "FAIL", "BLOCKED", "NOT_RUN"] },
        "failure_type": { "enum": ["ASSERTION", "LOCATOR", "REQUEST_FAILED", "PAGE_ERROR", "NAVIGATION", "TIMEOUT", "INFRASTRUCTURE"] },
        "expected": {},
        "actual": {},
        "failure_signature": { "$ref": "#/$defs/failure_signature" },
        "evidence": { "type": "object" },
        "blocked": { "$ref": "#/$defs/blocked" },
        "not_run": { "$ref": "#/$defs/not_run" },
        "timing": { "$ref": "#/$defs/timing" },
        "execution_context": { "$ref": "#/$defs/execution_context" },
        "isolation_id": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        { "if": { "properties": { "status": { "const": "BLOCKED" } } }, "then": { "required": ["blocked"] } },
        { "if": { "properties": { "status": { "const": "NOT_RUN" } } }, "then": { "required": ["not_run"] } },
        { "if": { "properties": { "status": { "const": "FAIL" } } }, "then": { "required": ["failure_type"] } }
      ]
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "lane", "started_at", "finished_at", "duration_ms", "cases"],
  "properties": {
    "run_id": { "type": "string", "minLength": 1 },
    "lane": { "enum": ["API", "PLAYWRIGHT_TEST", "MCP_DIAGNOSTIC", "STATIC", "LOG_STATE"] },
    "started_at": { "type": "string", "format": "date-time" },
    "finished_at": { "type": "string", "format": "date-time" },
    "duration_ms": { "type": "number", "minimum": 0 },
    "cases": { "type": "array", "items": { "$ref": "#/$defs/case_result" } }
  }
}
