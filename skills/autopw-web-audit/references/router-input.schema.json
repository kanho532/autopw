{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autopw.local/schemas/router-input.schema.json",
  "title": "AutoPW deterministic router input",
  "$defs": {
    "execution_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runner", "runner_version", "browser", "browser_build", "viewport", "locale",
        "timezone", "spec_path", "test_title", "storage_state_contract", "steps",
        "assertions", "locator_contract"
      ],
      "properties": {
        "runner": { "type": "string", "minLength": 1 },
        "runner_version": { "type": "string", "minLength": 1 },
        "browser": { "type": "string", "minLength": 1 },
        "browser_build": { "type": "string", "minLength": 1 },
        "viewport": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height"],
          "properties": {
            "width": { "type": "integer", "minimum": 1 },
            "height": { "type": "integer", "minimum": 1 }
          }
        },
        "locale": { "type": "string", "minLength": 1 },
        "timezone": { "type": "string", "minLength": 1 },
        "spec_path": { "type": "string", "minLength": 1 },
        "test_title": { "type": "string", "minLength": 1 },
        "storage_state_contract": { "type": "string", "minLength": 1 },
        "steps": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "assertions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "locator_contract": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "attempt": {
      "type": "object",
      "required": ["case_id", "attempt", "status", "timing", "execution_context", "isolation_id"],
      "properties": {
        "case_id": { "type": "string", "minLength": 1 },
        "attempt": { "type": "integer", "minimum": 1, "maximum": 2 },
        "status": { "enum": ["PASS", "FAIL", "BLOCKED"] },
        "failure_type": {
          "enum": ["ASSERTION", "LOCATOR", "REQUEST_FAILED", "PAGE_ERROR", "NAVIGATION", "TIMEOUT", "INFRASTRUCTURE"]
        },
        "expected": {},
        "actual": {},
        "failure_signature": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "case_id",
            "failure_type",
            "route",
            "assertion",
            "locator",
            "http_method",
            "http_status",
            "top_stack_frame"
          ],
          "properties": {
            "case_id": { "type": "string", "minLength": 1 },
            "failure_type": { "type": "string", "minLength": 1 },
            "route": { "type": ["string", "null"] },
            "assertion": { "type": ["string", "null"] },
            "locator": { "type": ["string", "null"] },
            "http_method": { "type": ["string", "null"] },
            "http_status": { "type": ["integer", "null"] },
            "top_stack_frame": { "type": ["string", "null"] }
          }
        },
        "evidence": { "type": "object" },
        "timing": {
          "type": "object",
          "required": ["started_at", "finished_at", "duration_ms"],
          "properties": {
            "started_at": { "type": "string", "format": "date-time" },
            "finished_at": { "type": "string", "format": "date-time" },
            "duration_ms": { "type": "number", "minimum": 0 }
          }
        },
        "execution_context": { "$ref": "#/$defs/execution_context" },
        "isolation_id": { "type": "string", "minLength": 1 }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "artifacts_root", "expected_case_ids", "cases"],
  "properties": {
    "run_id": { "type": "string", "minLength": 1 },
    "artifacts_root": { "type": "string", "minLength": 1 },
    "expected_case_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^BROWSER-[0-9]+$"
      }
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "mcp_trigger", "attempts"],
        "properties": {
          "case_id": { "type": "string", "minLength": 1 },
          "mcp_trigger": {
            "enum": ["NONE", "PLAYWRIGHT_FAILS_WITH_INCOMPLETE_EVIDENCE", "API_BROWSER_MISMATCH"]
          },
          "api_counterpart": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "same_business_invariant"],
            "properties": {
              "status": { "enum": ["PASS", "FAIL", "BLOCKED", "NOT_RUN"] },
              "same_business_invariant": { "type": "boolean" }
            }
          },
          "attempts": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "items": { "$ref": "#/$defs/attempt" }
          }
        }
      }
    }
  }
}
