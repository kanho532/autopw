{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autopw.local/schemas/router-input.schema.json",
  "title": "AutoPW deterministic router input",
  "$defs": {
    "router_attempt": {
      "allOf": [
        { "$ref": "https://autopw.local/schemas/lane-result.schema.json#/$defs/case_result" },
        {
          "if": { "properties": { "status": { "enum": ["PASS", "FAIL"] } } },
          "then": { "required": ["execution_context", "isolation_id"] }
        },
        {
          "if": { "properties": { "status": { "const": "FAIL" } } },
          "then": { "required": ["failure_signature"] }
        }
      ]
    },
    "router_case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "mcp_trigger", "attempts"],
      "properties": {
        "case_id": { "type": "string", "pattern": "^BROWSER-[0-9]+$" },
        "mcp_trigger": { "enum": ["NONE", "PLAYWRIGHT_FAILS_WITH_INCOMPLETE_EVIDENCE", "API_BROWSER_MISMATCH"] },
        "api_counterpart": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "same_business_invariant"],
          "properties": {
            "status": { "enum": ["PASS", "FAIL", "BLOCKED", "NOT_RUN"] },
            "same_business_invariant": { "type": "boolean" }
          }
        },
        "attempts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/router_attempt" }
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "artifacts_root", "expected_case_ids", "cases"],
  "properties": {
    "run_id": { "type": "string", "minLength": 1 },
    "artifacts_root": { "type": "string", "minLength": 1 },
    "expected_case_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^BROWSER-[0-9]+$" }
    },
    "cases": { "type": "array", "items": { "$ref": "#/$defs/router_case" } }
  }
}
