{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autopw.local/schemas/execution-plan.schema.json",
  "title": "AutoPW frozen execution intent",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "scope_mode", "frozen_at", "target", "environment", "cases"],
  "properties": {
    "run_id": { "type": "string", "minLength": 1 },
    "scope_mode": { "enum": ["FULL", "COMMIT_TO_WORKTREE"] },
    "frozen_at": { "type": "string", "format": "date-time" },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "head", "worktree_status"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "head": { "type": "string", "minLength": 1 },
        "baseline": { "type": ["string", "null"] },
        "worktree_status": { "type": "array", "items": { "type": "string" } }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timezone", "locale", "services", "playwright"],
      "properties": {
        "timezone": { "type": "string", "minLength": 1 },
        "locale": { "type": "string", "minLength": 1 },
        "services": { "type": "array", "items": { "type": "object" } },
        "playwright": { "type": "object" }
      }
    },
    "cases": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/case" } }
  },
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "channel", "executor", "source", "preconditions", "steps", "assertions", "evidence_contract", "dependencies", "resource_locks", "mutates", "cleanup", "mcp_trigger"],
      "properties": {
        "id": { "type": "string", "pattern": "^(API|BROWSER|STATIC|LOG_STATE|DISCOVERED)-[0-9]+$" },
        "title": { "type": "string", "minLength": 1 },
        "risk": { "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
        "channel": { "enum": ["API", "BROWSER", "STATIC", "LOG_STATE"] },
        "executor": { "enum": ["DIRECT_API", "PLAYWRIGHT_TEST", "STATIC", "LOG_STATE"] },
        "source": { "type": "object" },
        "preconditions": { "type": "array" },
        "steps": { "type": "array", "minItems": 1 },
        "assertions": { "type": "array", "minItems": 1 },
        "evidence_contract": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "dependencies": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "resource_locks": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "mutates": { "type": "boolean" },
        "cleanup": { "type": "array" },
        "api_counterpart_id": { "type": "string", "pattern": "^API-[0-9]+$" },
        "mcp_trigger": { "enum": ["NONE", "PLAYWRIGHT_FAILS_WITH_INCOMPLETE_EVIDENCE", "API_BROWSER_MISMATCH"] }
      },
      "allOf": [
        { "if": { "properties": { "channel": { "const": "BROWSER" } } }, "then": { "properties": { "executor": { "const": "PLAYWRIGHT_TEST" } } } },
        { "if": { "properties": { "channel": { "const": "API" } } }, "then": { "properties": { "executor": { "const": "DIRECT_API" } } } },
        { "if": { "properties": { "channel": { "const": "STATIC" } } }, "then": { "properties": { "executor": { "const": "STATIC" } } } },
        { "if": { "properties": { "channel": { "const": "LOG_STATE" } } }, "then": { "properties": { "executor": { "const": "LOG_STATE" } } } }
      ]
    }
  }
}
