{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autopw.local/schemas/execution-plan.schema.json",
  "title": "AutoPW frozen execution intent",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "scope_mode", "frozen_at", "target", "environment", "cases"],
  "properties": {
    "run_id": { "type": "string", "minLength": 1 },
    "scope_mode": { "enum": ["FULL", "COMMIT_TO_WORKTREE", "COMMIT_TO_COMMIT"] },
    "frozen_at": { "type": "string", "format": "date-time" },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "head", "worktree_status"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "head": { "type": "string", "minLength": 1 },
        "baseline": { "type": ["string", "null"] },
        "worktree_status": { "type": "array", "items": { "type": "string" } }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timezone", "locale", "services", "playwright"],
      "properties": {
        "timezone": { "type": "string", "minLength": 1 },
        "locale": { "type": "string", "minLength": 1 },
        "services": { "type": "array", "items": { "$ref": "#/$defs/service" } },
        "playwright": { "type": "object" }
      }
    },
    "cases": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/case" } }
  },
  "allOf": [
    {
      "if": { "properties": { "scope_mode": { "enum": ["COMMIT_TO_WORKTREE", "COMMIT_TO_COMMIT"] } } },
      "then": {
        "properties": {
          "target": {
            "required": ["baseline"],
            "properties": { "baseline": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" } }
          }
        }
      }
    },
    {
      "if": { "properties": { "scope_mode": { "const": "COMMIT_TO_COMMIT" } } },
      "then": {
        "properties": {
          "target": {
            "properties": {
              "head": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
              "worktree_status": { "maxItems": 0 }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "service": {
      "type": "object",
      "required": ["id", "managed_by", "data_isolation"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "managed_by": { "enum": ["AUTOPW", "EXTERNAL"] },
        "data_isolation": { "enum": ["EPHEMERAL", "RUN_PREFIX", "EXTERNAL"] },
        "host": { "type": "string", "minLength": 1 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "health_url": { "type": "string", "minLength": 1 }
      }
    },
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "value", "unique"],
      "properties": {
        "strategy": { "enum": ["TEST_ID", "ROLE", "LABEL", "PLACEHOLDER", "TEXT", "CSS", "RELATION"] },
        "value": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "parent": { "type": "string", "minLength": 1 },
        "exact": { "type": "boolean" },
        "unique": { "const": true }
      },
      "allOf": [
        {
          "if": { "properties": { "strategy": { "enum": ["ROLE", "LABEL", "PLACEHOLDER", "TEXT"] } } },
          "then": { "required": ["exact"], "properties": { "exact": { "const": true } } }
        },
        {
          "if": { "properties": { "strategy": { "const": "RELATION" } } },
          "then": { "required": ["parent"] }
        }
      ]
    },
    "locator_contract": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/locator" }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "channel", "executor", "source", "preconditions", "steps", "assertions", "evidence_contract", "dependencies", "resource_locks", "mutates", "cleanup", "mcp_trigger"],
      "properties": {
        "id": { "type": "string", "pattern": "^(API|BROWSER|STATIC|LOG_STATE|DISCOVERED)-[0-9]+$" },
        "title": { "type": "string", "minLength": 1 },
        "risk": { "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
        "channel": { "enum": ["API", "BROWSER", "STATIC", "LOG_STATE"] },
        "executor": { "enum": ["DIRECT_API", "PLAYWRIGHT_TEST", "STATIC", "LOG_STATE"] },
        "source": { "type": "object" },
        "preconditions": { "type": "array" },
        "steps": { "type": "array", "minItems": 1 },
        "assertions": { "type": "array", "minItems": 1 },
        "evidence_contract": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "dependencies": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "resource_locks": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "mutates": { "type": "boolean" },
        "cleanup": { "type": "array" },
        "locator_contract": { "$ref": "#/$defs/locator_contract" },
        "api_counterpart_id": { "type": "string", "pattern": "^API-[0-9]+$" },
        "mcp_trigger": { "enum": ["NONE", "PLAYWRIGHT_FAILS_WITH_INCOMPLETE_EVIDENCE", "API_BROWSER_MISMATCH"] }
      },
      "allOf": [
        { "if": { "properties": { "channel": { "const": "BROWSER" } } }, "then": { "required": ["locator_contract"], "properties": { "executor": { "const": "PLAYWRIGHT_TEST" } } } },
        { "if": { "properties": { "channel": { "const": "API" } } }, "then": { "properties": { "executor": { "const": "DIRECT_API" } } } },
        { "if": { "properties": { "channel": { "const": "STATIC" } } }, "then": { "properties": { "executor": { "const": "STATIC" } } } },
        { "if": { "properties": { "channel": { "const": "LOG_STATE" } } }, "then": { "properties": { "executor": { "const": "LOG_STATE" } } } }
      ]
    }
  }
}
